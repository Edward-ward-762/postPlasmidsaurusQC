{
    "inputs": [
        {
            "name": "Sample options",
            "description": "Parameters relating to the sample being analysed.",
            "advanced": false,
            "params": {
                "inputFile": {
                    "name": "Samples",
                    "description": "The samples to process.",
                    "required": true,
                    "type": "csv",
                    "takes_samples": true,
                    "columns": [
                        {
                            "name": "sample_id",
                            "type": "string",
                            "from_sample": "name",
                            "required": true,
                            "render": false
                        },
                        {
                            "name": "fastq_path",
                            "type": "data",
                            "required": true,
                            "render": true
                        },
                        {
                            "name": "genome_path",
                            "type": "data",
                            "required": true,
                            "render": true
                        }
                    ]
                }           
            }
        },
        {
            "name": "Pipeline parameters",
            "description": "General options and configuration for the pipeline.",
            "advanced": true,
            "params": {
                "outdir": {
                    "name": "Output directory",
                    "description": "Output directory name.",
                    "type": "string",
                    "default": "plasmidsaurusQC"
                }
            }
        }
    ]
}